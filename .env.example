# --- LLM providers ---
# Only the key matching SUMMARIZER_PROVIDER below needs to be set.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed once the OpenAI summarizer is implemented.
OPENAI_API_KEY=
# https://openrouter.ai/keys — one key, many swappable models.
OPENROUTER_API_KEY=

# --- Telegram delivery ---
# Create a bot via @BotFather, then message it once and hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API ---
# Shared secret for POST /api/trigger-digest (sent as the X-API-Key header).
API_KEY=change-me
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# --- Providers (interchangeable) ---
# One of: claude, openrouter, openai (not yet implemented), ollama (not yet implemented)
SUMMARIZER_PROVIDER=claude
# Only used when SUMMARIZER_PROVIDER=openrouter. Model catalog: https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash
TTS_PROVIDER=edge
# The digest script is always German — pick a German voice, otherwise you get
# a German script read with an English accent. List all voices with:
#   uv run edge-tts --list-voices | grep de-DE
EDGE_TTS_VOICE=de-DE-SeraphinaMultilingualNeural

# --- Storage ---
OUTPUT_DIR=output
